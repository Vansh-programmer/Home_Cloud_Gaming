# Copy to .env (cp .env.example .env) and fill in. .env is git-ignored.
# Loaded automatically by ./start.sh and by the systemd service.

# --- Remote play: pick ONE free relay (REQUIRED for players outside your home network) ---
# Option A (Recommended for India: Lowest Latency, NO Credit Card, Free 50GB/mo):
# Sign up in 30 seconds at https://www.metered.ca/tools/openrelay
# Metered has servers in Mumbai, India, reducing relay ping from 280ms to ~15-30ms!
# METERED_API_KEY=
# METERED_APP_NAME=
# OR paste the static credentials from Metered / ExpressTURN:
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Option B (Cloudflare Realtime TURN - asks for a card on some accounts):
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=

# --- Optional overrides ---------------------------------------------------------
# ADMIN_USER=vansh
# ADMIN_PASS=change-me
# PORT=8080
# PUBLIC_DOMAIN=vanshdev.online/cloudgaming

# --- Multi-Instance Multiplayer LAN Slots (Approach 2) --------------------------
# Number of simultaneous game instances allowed on this host PC (e.g. 4 for a 4-player co-op party)
MAX_CONCURRENT_SESSIONS=4

# --- Zero-Duplication Host Steam Library Mount -----------------------------------
# Share Steam games already installed on THIS PC without duplicating files or giving PC access
# auto = auto-discover host Steam library; off = disabled; or explicit path (/mnt/games/steamapps)
HOST_STEAM_LIBRARY=auto

