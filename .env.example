# Copy to .env (cp .env.example .env) and fill in. .env is git-ignored.
# Loaded automatically by ./start.sh and by the systemd service.

# --- Remote play: pick ONE free relay (REQUIRED for players outside your home network) ---
# Option A (no card, email signup): Metered / Open Relay or ExpressTURN.
# Paste the URLs and static credentials from the provider dashboard.
# Several URLs may be separated by commas (UDP + TCP + TLS 443 gives the best reach).
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Option B (Cloudflare Realtime TURN - asks for a card on some accounts):
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=

# --- Optional overrides ---------------------------------------------------------
# ADMIN_USER=vansh
# ADMIN_PASS=change-me
# PORT=8080
# PUBLIC_DOMAIN=vanshdev.online/cloudgaming
