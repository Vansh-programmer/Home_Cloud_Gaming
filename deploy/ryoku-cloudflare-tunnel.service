[Unit]
Description=Ryoku Cloud Gaming — Cloudflare Tunnel (vansh-cloud-gaming)
After=network-online.target ryoku-cloud-gaming.service
Wants=network-online.target

[Service]
Type=simple
User=vansh
WorkingDirectory=/home/vansh/Projects/Home_Cloud_Gaming
ExecStart=/usr/bin/cloudflared tunnel --config /home/vansh/Projects/Home_Cloud_Gaming/deploy/cloudflared-config.yml run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

