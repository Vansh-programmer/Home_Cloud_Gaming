[Unit]
Description=Ryoku Cloud Gaming Orchestrator & WebRTC Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vansh
WorkingDirectory=/home/vansh/Projects/Home_Cloud_Gaming
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/vansh/Projects/Home_Cloud_Gaming/engine/launch_phase6.py --host 0.0.0.0 --port 8080 --public-domain vanshdev.online/cloudgaming
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
