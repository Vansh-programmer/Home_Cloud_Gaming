# =============================================================================
# Ryoku Cloud Gaming - Caddy Gateway
# Automated HTTPS & WebCodecs WebSocket Proxy
# =============================================================================

{
    # Global options
    auto_https disable_redirects
}

http://vanshdev.online, http://play.vanshdev.online, http://localhost, http://127.0.0.1, http://192.168.1.5 {
    # 1. Cloudflare Worker Edge Health Check (Automatic Boot Detection)
    handle /api/health {
        header Content-Type "application/json"
        header Access-Control-Allow-Origin "*"
        header Cache-Control "no-store"
        respond `{"ok":true,"online":true,"server":"Ryoku Cloud Gaming PC","gpu":"NVIDIA GeForce RTX 4060","status":"ready"}` 200
    }

    # 2. Moonlight Web In-Browser Streaming WebSocket & Engine
    handle /stream* {
        reverse_proxy localhost:8080 {
            header_down -X-Frame-Options
            header_down -Content-Security-Policy
        }
    }
    handle /ws* {
        reverse_proxy localhost:8080
    }
    handle /api* {
        reverse_proxy localhost:8080
    }

    # 3. Main Web Portal UI
    handle {
        root * /usr/share/caddy
        file_server
        try_files {path} /index.html
    }
}

